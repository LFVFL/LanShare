# 统一换行，避免 Windows/Linux 互相改整份文件
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Preserve verification evidence bytes and the hashes recorded across reports.
docs/changes/**/test-results/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# 二进制
*.ico   binary
*.png   binary
*.jpg   binary
*.exe   binary
